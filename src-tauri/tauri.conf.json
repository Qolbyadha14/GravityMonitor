{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gravity Monitor",
  "version": "0.1.5",
  "identifier": "com.gravitymonitor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [
      {
        "title": "Gravity Monitor",
        "width": 1020,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0QThGNEVFQzBGMzlGMDQKUldRRW4vUEE3dlNvOU9VeWx4M3gwZURIOHJWRWdidFFWdGowTkVEMDFOYjBBdW9HR2VYWDF3YnAK",
      "endpoints": [
        "https://github.com/Qolbyadha14/GravityMonitor/releases/latest/download/latest.json"
      ]
    }
  }
}
